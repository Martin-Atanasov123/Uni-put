{
  "name": "uni-put",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && vite build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e/**",
