    "@supabase/supabase-js": "2.105.4",
    "@tailwindcss/vite": "^4.1.18",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.7",
    "react-router-dom": "^7.18.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.65.1",
