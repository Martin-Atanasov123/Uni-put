    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^12.9.0",
    "daisyui": "^5.5.14",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.1.18",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
